{
  "info": {
    "name": "Backend API",
    "_postman_id": "b1a1c1d0-0000-4000-8000-000000000001",
    "description": "Colección de endpoints del Backend API (Node + Express + Sequelize).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "versionFormatoId", "value": "" },
    { "key": "campoTemperaturaId", "value": "" },
    { "key": "unidadCelsiusId", "value": "" },
    { "key": "inspeccionId", "value": "" },
    { "key": "desviacionId", "value": "" },
    { "key": "accionAlertaId", "value": "" },
    { "key": "accionObservacionId", "value": "" },
    { "key": "accionEvidenciaId", "value": "" },
    { "key": "accionCorrectivaId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res && res.data) {",
                  "  pm.collectionVariables.set('token', res.data.token);",
                  "  pm.collectionVariables.set('refreshToken', res.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@empresa.com\",\n  \"password\": \"Admin123*\"\n}"
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/perfil", "host": ["{{baseUrl}}"], "path": ["api", "auth", "perfil"] }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        { "name": "Listar", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] } } },
        { "name": "Crear", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/usuarios", "host": ["{{baseUrl}}"], "path": ["api", "usuarios"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Nuevo\",\n  \"correo\": \"nuevo@empresa.com\",\n  \"password\": \"Password1\",\n  \"rolId\": \"UUID-DEL-ROL\"\n}" } } },
        { "name": "Obtener", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/usuarios/:id", "host": ["{{baseUrl}}"], "path": ["api", "usuarios", ":id"] } } },
        { "name": "Actualizar", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/usuarios/:id", "host": ["{{baseUrl}}"], "path": ["api", "usuarios", ":id"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Actualizado\"\n}" } } },
        { "name": "Eliminar", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/usuarios/:id", "host": ["{{baseUrl}}"], "path": ["api", "usuarios", ":id"] } } }
      ]
    },
    {
      "name": "Roles",
      "item": [
        { "name": "Listar", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/roles", "host": ["{{baseUrl}}"], "path": ["api", "roles"] } } },
        { "name": "Crear", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/roles", "host": ["{{baseUrl}}"], "path": ["api", "roles"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"NuevoRol\",\n  \"descripcion\": \"...\",\n  \"permisos\": [],\n  \"menus\": []\n}" } } },
        { "name": "Actualizar", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/roles/:id", "host": ["{{baseUrl}}"], "path": ["api", "roles", ":id"] }, "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"Actualizado\"\n}" } } },
        { "name": "Eliminar", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/roles/:id", "host": ["{{baseUrl}}"], "path": ["api", "roles", ":id"] } } }
      ]
    },
    {
      "name": "Permisos",
      "item": [
        { "name": "Listar", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/permisos", "host": ["{{baseUrl}}"], "path": ["api", "permisos"] } } },
        { "name": "Crear", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/permisos", "host": ["{{baseUrl}}"], "path": ["api", "permisos"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Modulo.Accion\",\n  \"modulo\": \"Modulo\"\n}" } } }
      ]
    },
    {
      "name": "Menus",
      "item": [
        { "name": "Listar", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/menus", "host": ["{{baseUrl}}"], "path": ["api", "menus"] } } },
        { "name": "Crear", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/menus", "host": ["{{baseUrl}}"], "path": ["api", "menus"] }, "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Reportes\",\n  \"ruta\": \"/reportes\",\n  \"icono\": \"assessment\",\n  \"orden\": 10\n}" } } }
      ]
    },
    {
      "name": "Calidad",
      "item": [
        { "name": "Listar tipos de inspección", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/calidad/tipos-inspeccion", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "tipos-inspeccion"] } } },
        { "name": "Crear tipo de inspección", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/calidad/tipos-inspeccion", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "tipos-inspeccion"] }, "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"RECEPCION\",\n  \"nombre\": \"Recepción\",\n  \"descripcion\": \"Control al recibir materias primas\"\n}" } } },
        { "name": "Listar unidades de medida", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/calidad/unidades-medida", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "unidades-medida"] } } },
        { "name": "Listar parámetros con reglas", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/calidad/parametros", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "parametros"] } } },
        { "name": "Crear parámetro reutilizable", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/calidad/parametros", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "parametros"] }, "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"CLORO_AGUA_POTABLE\",\n  \"nombre\": \"Cloro agua potable\",\n  \"tipoCampoId\": \"UUID-NUMERO\",\n  \"unidadMedidaId\": \"UUID-MG-L\",\n  \"valorMinimo\": 0.3,\n  \"valorMaximo\": 2,\n  \"precisionDecimal\": 2,\n  \"esObligatorioDefault\": true\n}" } } },
        { "name": "Listar tipos de campo", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/calidad/tipos-campo", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "tipos-campo"] } } },
        { "name": "Listar niveles de severidad", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/calidad/niveles-severidad", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "niveles-severidad"] } } },
        { "name": "Listar tipos de acción", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/calidad/tipos-accion", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "tipos-accion"] } } },
        { "name": "Crear formato con versión inicial", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/calidad/formatos", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "formatos"] }, "body": { "mode": "raw", "raw": "{\n  \"codigo\": \"TEMP-CAVA\",\n  \"nombre\": \"Control de temperatura cuarto frío\",\n  \"tipoInspeccionId\": \"UUID-TIPO-INSPECCION\",\n  \"versionInicial\": {\n    \"numeroVersion\": 1,\n    \"fechaVigenciaDesde\": \"2026-08-11\"\n  }\n}" } } },
        { "name": "Crear sección", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/calidad/secciones-formato", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "secciones-formato"] }, "body": { "mode": "raw", "raw": "{\n  \"versionFormatoId\": \"UUID-VERSION\",\n  \"nombre\": \"Mediciones\",\n  \"orden\": 1\n}" } } },
        { "name": "Crear campo desde parámetro", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/calidad/campos-formato", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "campos-formato"] }, "body": { "mode": "raw", "raw": "{\n  \"seccionFormatoId\": \"UUID-SECCION\",\n  \"parametroCalidadId\": \"UUID-TEMPERATURA\",\n  \"etiqueta\": \"Temperatura de cava\",\n  \"esObligatorio\": true,\n  \"orden\": 1\n}" } } },
        { "name": "Obtener versión completa", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/api/calidad/versiones-formato/:id/completa", "host": ["{{baseUrl}}"], "path": ["api", "calidad", "versiones-formato", ":id", "completa"] } } }
      ]
    },
    {
      "name": "Reglas de calidad",
      "item": [
        { "name": "Crear regla por parámetro", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/reglas/reglas-calidad", "host": ["{{baseUrl}}"], "path": ["api", "reglas", "reglas-calidad"] }, "body": { "mode": "raw", "raw": "{\n  \"parametroCalidadId\": \"UUID-PARAMETRO\",\n  \"codigo\": \"CLORO_BAJO\",\n  \"nombre\": \"Cloro por debajo del rango\",\n  \"resultado\": \"NO_CUMPLE\",\n  \"nivelSeveridadId\": \"UUID-ALTA\",\n  \"mensajeIncumplimiento\": \"Cloro por debajo de 0.3 mg/l\",\n  \"operadorLogico\": \"AND\"\n}" } } },
        { "name": "Crear condición", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/reglas/condiciones-regla", "host": ["{{baseUrl}}"], "path": ["api", "reglas", "condiciones-regla"] }, "body": { "mode": "raw", "raw": "{\n  \"reglaCalidadId\": \"UUID-REGLA\",\n  \"tipoCondicion\": \"RANGO\",\n  \"operador\": \"FUERA_DE_RANGO\",\n  \"valor1\": \"0\",\n  \"valor2\": \"4\",\n  \"orden\": 1\n}" } } },
        { "name": "Crear acción", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{baseUrl}}/api/reglas/acciones-regla", "host": ["{{baseUrl}}"], "path": ["api", "reglas", "acciones-regla"] }, "body": { "mode": "raw", "raw": "{\n  \"reglaCalidadId\": \"UUID-REGLA\",\n  \"tipoAccionId\": \"UUID-TIPO-ACCION\",\n  \"configuracion\": {},\n  \"orden\": 1\n}" } } }
      ]
    }
  ]
}
